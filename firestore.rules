rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Allow only authenticated users to read/write 'services' collection
    match /services/{serviceId} {
      allow read, write: if request.auth != null;
    }

    // Allow only authenticated users to read/write 'packages' collection
    match /packages/{packageId} {
      allow read, write: if request.auth != null;
    }

    // Allow only authenticated users to read/write 'gallery' collection
    match /gallery/{galleryId} {
      allow read, write: if request.auth != null;
    }

    // Allow only authenticated users to read/write 'contacts' collection
    match /contacts/{contactId} {
      allow read, write: if request.auth != null;
    }

    // Allow anyone to read testimonials, but only authenticated users can create
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if false; // disallow edit/delete for now
    }

    // Default deny all other requests
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
